# Copie para `.env` antes de rodar `npm run dev`. Valores só de desenvolvimento.

# Ambiente
NODE_ENV=development
PORT=3000

# Banco (o boot valida a configuração; a conexão só abre na primeira consulta)
# O banco e o usuário precisam existir antes da primeira consulta.
DATABASE_ENGINE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=maat_dev
DATABASE_USER=maat
DATABASE_PASSWORD=dev-only-password

# CORS (lista separada por vírgula, apenas esquema + host + porta)
CORS_ORIGINS=http://localhost:5173

# Sessão (C6)
JWT_SECRET=dev-only-jwt-secret-replace-with-at-least-32-chars
JWT_EXPIRES_IN=1d
COOKIE_NAME=session_id

# Protocolo
PROTOCOL_SECRET=dev-only-protocol-secret-replace-with-at-least-32-chars

# Limites de corpo
JSON_BODY_MAX_BYTES=1048576
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_FILES=5
