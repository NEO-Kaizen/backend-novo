{
  "openapi": "3.1.0",
  "info": {
    "title": "MAAT Backend API",
    "version": "0.0.0",
    "description": "Contrato HTTP do backend-novo. As operações serão geradas a partir dos schemas Zod."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Base path da API; a origem é definida pelo ambiente."
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {},
  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "validation_error",
          "not_found",
          "conflict",
          "unauthorized",
          "forbidden",
          "payload_too_large",
          "invalid_content_type",
          "rate_limited",
          "internal_error",
          "not_the_assignee",
          "invalid_status_transition"
        ],
        "description": "Código estável em snake_case. A lista abaixo é montada de EXPOSED_ERROR_CODES mais os códigos de domínio conhecidos (not_the_assignee, invalid_status_transition); clientes devem ter fallback para códigos desconhecidos. Os códigos de core/errors/internal-codes.ts nunca são expostos.",
        "example": "not_found"
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Caminho do campo, por exemplo demand.title."
          },
          "message": {
            "type": "string",
            "description": "Mensagem pt-BR do campo."
          }
        },
        "required": ["path", "message"],
        "description": "Erro de validação de um campo.",
        "example": {
          "path": "demand.title",
          "message": "Informe o título."
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "error"
          },
          "statusCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "message": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "requestId": {
            "description": "Correlation id HTTP (aditivo).",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["status", "statusCode", "message"],
        "additionalProperties": true,
        "description": "Envelope de erro vigente (legado, ADR-0005), sem os aditivos de validação e concorrência. As respostas de validação e concorrência referenciam os componentes derivados.",
        "example": {
          "status": "error",
          "statusCode": 404,
          "message": "Solicitação não encontrada.",
          "code": "not_found",
          "requestId": "00000000-0000-4000-8000-000000000000"
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "error"
          },
          "statusCode": {
            "type": "integer",
            "const": 400
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "const": "validation_error"
          },
          "requestId": {
            "description": "Correlation id HTTP (aditivo).",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": ["status", "statusCode", "message", "code", "fields"],
        "additionalProperties": true,
        "description": "Envelope do 400 de validação unificado (transitório, migração C2): fields é um array.",
        "example": {
          "status": "error",
          "statusCode": 400,
          "message": "Dados inválidos.",
          "code": "validation_error",
          "fields": [
            {
              "path": "demand.title",
              "message": "Informe o título."
            }
          ]
        }
      },
      "LegacyValidationError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "error"
          },
          "statusCode": {
            "type": "integer",
            "const": 422
          },
          "message": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "requestId": {
            "description": "Correlation id HTTP (aditivo).",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["status", "statusCode", "message", "fields"],
        "additionalProperties": true,
        "description": "Corpo 422 vigente do fluxo de requests durante a migração C2: fields é um objeto indexado pelo caminho do campo. Será removido quando o 400 unificado entrar.",
        "example": {
          "status": "error",
          "statusCode": 422,
          "message": "Dados inválidos.",
          "fields": {
            "demand.title": "Informe o título."
          }
        }
      },
      "ConflictError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "error"
          },
          "statusCode": {
            "type": "integer",
            "const": 409
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "const": "conflict"
          },
          "requestId": {
            "description": "Correlation id HTTP (aditivo).",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "currentStatusKey": {
            "type": "string",
            "description": "Key do status atual (§8.1 de 04-API-Conventions.md)."
          },
          "currentStatusId": {
            "description": "UUID do status atual (fallback de migração).",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["status", "statusCode", "message", "code", "currentStatusKey"],
        "additionalProperties": true,
        "description": "Envelope do 409 de concorrência: estende ErrorEnvelope com a key do status atual e, opcionalmente, o UUID de fallback.",
        "example": {
          "status": "error",
          "statusCode": 409,
          "message": "O status foi alterado por outra pessoa.",
          "code": "conflict",
          "currentStatusKey": "in_progress"
        }
      },
      "PaginatedResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {}
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Página efetiva (1-based). Acima de `totalPages`, é ajustada para `totalPages`; com `total` 0, volta 1 (§4.2)."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Tamanho efetivo da página. Sem default próprio: o default 20 e o máximo 100 são do parâmetro de request `PageSize`; acima do máximo a request recebe 400 validation_error (§4.2)."
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["data", "page", "pageSize", "total", "totalPages"],
        "additionalProperties": true,
        "description": "Envelope de paginação padrão.",
        "example": {
          "data": [],
          "page": 1,
          "pageSize": 20,
          "total": 0,
          "totalPages": 0
        }
      }
    },
    "parameters": {
      "PageSize": {
        "in": "query",
        "name": "pageSize",
        "schema": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "description": "Default 20; máximo 100. Acima do máximo a API responde 400 validation_error.",
        "example": 20
      },
      "RequesterEmail": {
        "in": "header",
        "name": "X-Requester-Email",
        "schema": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "required": false,
        "description": "E-mail do solicitante na janela de compatibilidade; não autentica. Ver `04-API-Conventions.md` §15.3 e ADR-0023.",
        "example": "requester@example.com"
      },
      "RequesterIdentity": {
        "in": "header",
        "name": "X-Requester-Identity",
        "schema": {
          "type": "string"
        },
        "required": false,
        "deprecated": true,
        "description": "Identidade legada aceita por uma release; será removida quando a janela de compatibilidade fechar (ADR-0023).",
        "example": "legacy-requester"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session_id",
        "description": "Sessão JWT em cookie HttpOnly; nome default session_id."
      }
    }
  }
}
