{
  "openapi": "3.1.0",
  "info": {
    "title": "MAAT Backend API",
    "version": "0.0.0",
    "description": "Contrato HTTP do backend-novo. As operações serão geradas a partir dos schemas Zod."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Base path da API; a origem é definida pelo ambiente."
    }
  ],
  "paths": {},
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session_id",
        "description": "Sessão JWT em cookie HttpOnly; nome default session_id."
      }
    },
    "parameters": {
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "description": "Default 20; máximo 100. Acima do máximo a API responde 400 validation_error.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "description": "Envelope de erro vigente (legado, ADR-0005).",
        "properties": {
          "status": {
            "type": "string",
            "const": "error"
          },
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Correlation id HTTP (aditivo)."
          },
          "fields": {
            "type": "array",
            "description": "Erros por campo (aditivo, em validação).",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"]
            }
          },
          "currentStatusKey": {
            "type": "string",
            "description": "409 de concorrência: key do status atual (§8.1)."
          },
          "currentStatusId": {
            "type": "string",
            "format": "uuid",
            "description": "409 de concorrência: UUID do status atual (fallback de migração)."
          }
        },
        "required": ["status", "statusCode", "message"]
      },
      "PaginatedResponse": {
        "type": "object",
        "description": "Envelope de paginação padrão.",
        "properties": {
          "data": {
            "type": "array",
            "items": {}
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Tamanho efetivo da página; máximo 100 (§4.2)."
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["data", "page", "pageSize", "total", "totalPages"]
      },
      "ErrorCode": {
        "type": "string",
        "description": "Código estável em snake_case. Será gerado de core/errors/error-codes.ts; os códigos de core/errors/internal-codes.ts nunca são expostos.",
        "enum": [
          "validation_error",
          "unauthorized",
          "forbidden",
          "not_found",
          "conflict",
          "rate_limited",
          "invalid_content_type",
          "payload_too_large",
          "internal_error",
          "not_the_assignee",
          "invalid_status_transition"
        ]
      }
    }
  },
  "security": [
    {
      "sessionCookie": []
    }
  ]
}
