{
  "openapi": "3.1.0",
  "info": {
    "title": "MAAT Backend API",
    "version": "0.0.0",
    "description": "Contrato HTTP publicado do backend-novo. Gerado a partir dos schemas Zod; não editar manualmente."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Desenvolvimento local"
    }
  ],
  "paths": {},
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session_id",
        "description": "Sessão JWT em cookie HttpOnly."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "description": "Envelope de erro vigente (legado, ADR-0005).",
        "properties": {
          "status": {
            "type": "string",
            "const": "error"
          },
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Código estável em snake_case (aditivo)."
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Correlation id HTTP (aditivo)."
          },
          "fields": {
            "type": "array",
            "description": "Erros por campo (aditivo, em validação).",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"]
            }
          }
        },
        "required": ["status", "statusCode", "message"]
      },
      "PaginatedResponse": {
        "type": "object",
        "description": "Envelope de paginação padrão.",
        "properties": {
          "data": {
            "type": "array",
            "items": {}
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["data", "page", "pageSize", "total", "totalPages"]
      }
    }
  },
  "security": [
    {
      "sessionCookie": []
    }
  ]
}
