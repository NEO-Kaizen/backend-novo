{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:.context7API}",
        },
      },
    },
  },
  "permissions": [
    // Base: qualquer comando de shell pede confirmação, salvo as exceções abaixo.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Todo comando Git pede confirmação, exceto os comandos liberados logo abaixo.
    { "action": "shell", "resource": "git *", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },

    // Leitura de objetos/refs/index (somente padrões seguros)
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git name-rev *", "effect": "allow" },
    { "action": "shell", "resource": "git for-each-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git show-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git count-objects *", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog *", "effect": "allow" },
    { "action": "shell", "resource": "git describe *", "effect": "allow" },
    { "action": "shell", "resource": "git show-branch *", "effect": "allow" },
    { "action": "shell", "resource": "git cherry *", "effect": "allow" },

    // Leitura adicional (override cobre flags perigosas)
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git bisect log*", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v*", "effect": "allow" },
    { "action": "shell", "resource": "git remote show*", "effect": "allow" },
    { "action": "shell", "resource": "git remote get-url*", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git stash list*", "effect": "allow" },
    { "action": "shell", "resource": "git stash show*", "effect": "allow" },
    { "action": "shell", "resource": "git reflog", "effect": "allow" },
    { "action": "shell", "resource": "git reflog show*", "effect": "allow" },
    { "action": "shell", "resource": "git diff-files *", "effect": "allow" },
    { "action": "shell", "resource": "git diff-index *", "effect": "allow" },
    { "action": "shell", "resource": "git diff-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git range-diff *", "effect": "allow" },
    { "action": "shell", "resource": "git whatchanged *", "effect": "allow" },
    { "action": "shell", "resource": "git cat-file *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-remote *", "effect": "allow" },
    { "action": "shell", "resource": "git fsck *", "effect": "allow" },
    { "action": "shell", "resource": "git verify-commit *", "effect": "allow" },
    { "action": "shell", "resource": "git verify-tag *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --verify*", "effect": "allow" },

    // Checagens (somente leitura)
    { "action": "shell", "resource": "git check-attr *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ignore *", "effect": "allow" },
    { "action": "shell", "resource": "git check-ref-format *", "effect": "allow" },

    // Branch/tag (somente leitura inerente)
    { "action": "shell", "resource": "git branch", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current*", "effect": "allow" },
    { "action": "shell", "resource": "git tag", "effect": "allow" },

    // Worktree/submodule/notes/rerere (somente leitura)
    { "action": "shell", "resource": "git worktree list*", "effect": "allow" },
    { "action": "shell", "resource": "git submodule status*", "effect": "allow" },
    { "action": "shell", "resource": "git submodule summary*", "effect": "allow" },
    { "action": "shell", "resource": "git notes list*", "effect": "allow" },
    { "action": "shell", "resource": "git notes show*", "effect": "allow" },
    { "action": "shell", "resource": "git rerere status*", "effect": "allow" },
    { "action": "shell", "resource": "git rerere diff*", "effect": "allow" },

    // GitHub CLI: todo comando pede confirmação por padrão.
    { "action": "shell", "resource": "gh *", "effect": "ask" },
    { "action": "shell", "resource": "gh status*", "effect": "allow" },
    { "action": "shell", "resource": "gh auth status*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks*", "effect": "allow" },
    { "action": "shell", "resource": "gh run view*", "effect": "allow" },
    { "action": "shell", "resource": "gh run watch*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue status*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff*", "effect": "allow" },
    { "action": "shell", "resource": "gh repo list*", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view*", "effect": "allow" },
    { "action": "shell", "resource": "gh run list*", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow list*", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow view*", "effect": "allow" },
    { "action": "shell", "resource": "gh release list*", "effect": "allow" },
    { "action": "shell", "resource": "gh release view*", "effect": "allow" },
    { "action": "shell", "resource": "gh project list*", "effect": "allow" },
    { "action": "shell", "resource": "gh project view*", "effect": "allow" },
    { "action": "shell", "resource": "gh project field-list*", "effect": "allow" },
    { "action": "shell", "resource": "gh project item-list*", "effect": "allow" },
    { "action": "shell", "resource": "gh org list*", "effect": "allow" },
    { "action": "shell", "resource": "gh search code*", "effect": "allow" },
    { "action": "shell", "resource": "gh search commits*", "effect": "allow" },
    { "action": "shell", "resource": "gh search issues*", "effect": "allow" },
    { "action": "shell", "resource": "gh search prs*", "effect": "allow" },
    { "action": "shell", "resource": "gh search repos*", "effect": "allow" },
    { "action": "shell", "resource": "gh ruleset list*", "effect": "allow" },
    { "action": "shell", "resource": "gh ruleset view*", "effect": "allow" },
    { "action": "shell", "resource": "gh ruleset check*", "effect": "allow" },
    { "action": "shell", "resource": "gh cache list*", "effect": "allow" },
    { "action": "shell", "resource": "gh label list*", "effect": "allow" },

    // Núcleo seguro de shell (somente leitura, sem mutação/execução)
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "paste *", "effect": "allow" },
    { "action": "shell", "resource": "column *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "egrep *", "effect": "allow" },
    { "action": "shell", "resource": "fgrep *", "effect": "allow" },
    { "action": "shell", "resource": "yq *", "effect": "allow" },
    { "action": "shell", "resource": "df *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "sha256sum *", "effect": "allow" },
    { "action": "shell", "resource": "md5sum *", "effect": "allow" },
    { "action": "shell", "resource": "tsc --noEmit*", "effect": "allow" },
    { "action": "shell", "resource": "prettier --check*", "effect": "allow" },
    { "action": "shell", "resource": "npm ls *", "effect": "allow" },
    { "action": "shell", "resource": "npm view *", "effect": "allow" },
    { "action": "shell", "resource": "npm outdated *", "effect": "allow" },
    { "action": "shell", "resource": "opencode mcp list*", "effect": "allow" },

    // Overrides de segurança: comandos liberados acima que aceitam flags perigosas
    // (escrita de arquivos, execução de helpers externos, vazamento de segredos)
    // pedem confirmação quando essas flags aparecem. Last-match-wins.
    { "action": "shell", "resource": "*--output*", "effect": "ask" },
    { "action": "shell", "resource": "*--ext-diff*", "effect": "ask" },
    { "action": "shell", "resource": "*--textconv*", "effect": "ask" },
    { "action": "shell", "resource": "*--filters*", "effect": "ask" },
    { "action": "shell", "resource": "*--upload-pack*", "effect": "ask" },
    { "action": "shell", "resource": "*--lost-found*", "effect": "ask" },
    { "action": "shell", "resource": "*--pre*", "effect": "ask" },
    { "action": "shell", "resource": "*--exec*", "effect": "ask" },
    { "action": "shell", "resource": "* -x*", "effect": "ask" },
    { "action": "shell", "resource": "*--compress-program*", "effect": "ask" },
    { "action": "shell", "resource": "*--show-token*", "effect": "ask" },
    { "action": "shell", "resource": "*--watch*", "effect": "ask" },
    { "action": "shell", "resource": "*--log*", "effect": "ask" },
    { "action": "shell", "resource": "*--log-failed*", "effect": "ask" },
    { "action": "shell", "resource": "gh run view *--log*", "effect": "ask" },

    // Scripts versionados e revisados no package.json.
    { "action": "shell", "resource": "npm run *", "effect": "allow" },
    { "action": "shell", "resource": "npm run *env*", "effect": "ask" },

    // Outros comandos destrutivos ou que alteram dependências.
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "npm install *", "effect": "ask" },
    { "action": "shell", "resource": "npm ci *", "effect": "ask" },
    { "action": "shell", "resource": "npm i *", "effect": "ask" },

    // Segredos por último: o deny vence as regras de Git, npm e comandos destrutivos.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    // Exemplo exato: `*.env.example` não libera variações como `.env.example.prod`.
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // Cadeias em que um subcomando cita `.env` são negadas; use `read`/`edit` no exemplo.
    { "action": "shell", "resource": "*.env*", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    // Secret local do Context7: o arquivo fica na raiz e é ignorado pelo Git.
    { "action": "read", "resource": "*.context7API", "effect": "deny" },
    { "action": "edit", "resource": "*.context7API", "effect": "deny" },
    { "action": "shell", "resource": "*context7API*", "effect": "deny" },

    // Fora do projeto: sempre confirmar.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
  ],
}
